{
  "name": "dsh-extension-hub",
  "description": "DSH Web GUI 扩展中心：技能与插件一体化管理（合并标注、一键启动/停止/卸载、GitHub/Gitee 远程搜索与一键安装、全量中文功能简介）。Hot-pluggable — 接入 web profile 后无需改 dsh 源码。",
  "version": "0.2.8",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skill",
    "extension-manager",
    "web-ui"
  ],
  "author": "remyoli77",
  "repository": {
    "type": "git",
    "url": "https://github.com/remyoli77/dsh-extension-hub.git"
  },
  "homepage": "https://github.com/remyoli77/dsh-extension-hub",
  "bugs": {
    "url": "https://github.com/remyoli77/dsh-extension-hub/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "yaml": "^2.4.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "tools"
  ]
}